# Neon Postgres — DIRECT connection string, your own full-access role.
# Used only by src/clean_and_load.py (DDL + data load).
DATABASE_URL_DIRECT=postgresql://**

# Neon Postgres — POOLED connection string (-pooler host).
# Used by the Streamlit app's tests and any local script hitting the chatbot path.
# This one should be authenticated as chatbot_readonly, NOT your full-access role.
DATABASE_URL_POOLED=postgresql://**


# Groq API key (console.groq.com)
GROQ_API_KEY=gsk_**

