# Copy this file to .streamlit/secrets.toml for local development.
# secrets.toml itself is gitignored — never commit it, even to a private repo.
# On Streamlit Community Cloud, set these same keys via the app's
# Settings -> Secrets panel instead of shipping this file.

GROQ_API_KEY = "gsk_**"

# Use the POOLED connection string here, authenticating as chatbot_readonly,
# not your full-access role.
DATABASE_URL = "postgresql://**=require"
